# Enable directory listing
Options +Indexes

# Set the default file for directory access
DirectoryIndex index.php index.html

# Enable URL rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect old URLs to new ones (example rule)
    # RewriteRule ^old-page\.html$ new-page.html [R=301,L]
    
    # Remove trailing slash from URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Redirect all requests to index.php if not a real file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Prevent access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini|phar|env)$">
    Require all denied
</FilesMatch>

# Enable Cross-Origin Resource Sharing (CORS) for images
<FilesMatch "\.(jpg|jpeg|png|gif|svg)$">
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# Disable directory listing for specific directories (optional)
<Directory "private">
    Options -Indexes
</Directory>

# Set caching for images and other static resources
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>